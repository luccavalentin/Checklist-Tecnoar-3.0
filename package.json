{
  "name": "tecnoar-os",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build -c vite.app.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "dev:app": "vite -c vite.app.config.ts",
    "nativo": "vite build -c vite.app.config.ts && cap sync",
    "nativo:android": "npm run nativo && cap open android",
    "nativo:ios": "npm run nativo && cap open ios",
    "test:sos": "node scripts/testes-sos/teste-sos.mjs && node scripts/testes-sos/impressao.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.7",
    "@types/pdfmake": "^0.3.3",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pdfmake": "^0.3.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
