# Projeto Supabase do Sistema Operacional Tecnoar.
# A chave publicável é pública por definição — o acesso real é controlado por RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leitura de placa e do documento do veículo por foto.
# Vazio (o normal): usa a função de borda `placa`, que fala com a Tecnoar IA já
# configurada na central. Em `mock`, nada é enviado: a placa sai do nome do
# arquivo, para desenvolver sem gastar chamada de IA.
VITE_PLACA_PROVIDER=
